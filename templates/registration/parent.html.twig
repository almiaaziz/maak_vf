{% extends 'base.html.twig' %}
{% block title %}Create a parent account — MAAK{% endblock %}
{% block body %}<div class="auth-shell"><a href="{{ path('app_home') }}" class="brand auth-brand"><span class="brand-mark">▤</span>MAAK<span class="brand-dot">.</span></a><div class="auth-card auth-card-wide"><a class="back-link" href="{{ path('app_register') }}">← Choose account type</a><p class="eyebrow">Join MAAK</p><h1>Create a parent account</h1><p class="auth-intro">One account to manage your family’s learning.</p>
{% for message in app.flashes('error') %}<div class="alert-error">{{ message }}</div>{% endfor %}
<form method="post" class="auth-form form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('registration') }}">
<label>First name<input type="text" name="first_name" placeholder="First name" required autocomplete="given-name"></label><label>Last name<input type="text" name="last_name" placeholder="Last name" required autocomplete="family-name"></label><label class="full-field">Email address<input type="email" name="email" placeholder="you@example.com" required autocomplete="email"></label>
<label class="full-field">Phone number<input type="tel" name="phone" placeholder="+216" required></label><label class="full-field">Address <span class="optional">Optional</span><input type="text" name="address" placeholder="Your address"></label>
<label>Password<input type="password" name="password" placeholder="At least 8 characters" minlength="8" required autocomplete="new-password"></label><label>Confirm password<input type="password" name="confirm_password" placeholder="Repeat your password" minlength="8" required autocomplete="new-password"></label>
<label class="terms-check full-field"><input type="checkbox" name="terms" value="1" required><span>I accept the terms and conditions.</span></label><button class="button button-primary button-full button-lg full-field" type="submit">Create account <span>→</span></button></form><p class="auth-switch">Already have an account? <a href="{{ path('app_login') }}">Log in</a></p></div><p class="auth-legal">Your information is protected and only used to manage your MAAK account.</p></div>{% endblock %}

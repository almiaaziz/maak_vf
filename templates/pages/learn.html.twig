{% extends 'base.html.twig' %}
{% block title %}{{ course.title }} — Learning space{% endblock %}
{% block body %}<div class="learning-shell"><header class="learning-header"><a href="{{ path('app_parent_dashboard') }}" class="brand"><span class="brand-mark">▤</span>MAAK<span class="brand-dot">.</span></a><a href="{{ path('app_course_show',{id:course.id}) }}" class="back-link">← Course overview</a></header><div class="learning-layout"><aside class="learning-curriculum"><p class="eyebrow">Course curriculum</p><h2>{{ course.title }}</h2>{% for section in course.sections %}<details open><summary>{{ section.title }}</summary>{% for lesson in section.lessons %}<div class="learning-lesson">▷ <span>{{ lesson.title }}</span><small>{{ lesson.duration }}</small></div>{% endfor %}</details>{% endfor %}</aside><main class="learning-content"><div class="video-placeholder"><span>▶</span><p>Lesson player</p><small>Video content will be connected to the Learning module.</small></div><p class="eyebrow">{{ course.subject }}</p><h1>{{ course.sections[0].lessons[0].title }}</h1><p>{{ course.subtitle }}</p><div class="lesson-actions"><button class="button button-outline">← Previous lesson</button><button class="button button-primary">Mark as complete →</button></div></main></div></div>{% endblock %}

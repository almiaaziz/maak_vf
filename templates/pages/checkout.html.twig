{% extends 'base.html.twig' %}
{% block title %}Checkout — MAAK{% endblock %}
{% block body %}{% include 'components/_navbar.html.twig' %}<main class="page-wrap checkout-page"><div class="page-intro"><p class="eyebrow">Almost there</p><h1>Complete your order</h1><p>Your purchase gives every child in your parent account access to this course.</p></div><div class="checkout-grid"><section class="panel-card"><h2>Order summary</h2><div class="checkout-course"><img src="{{ asset('images/maak/' ~ course.image) }}"><div><strong>{{ course.title }}</strong><small>{{ course.teacher }} · {{ course.duration }}</small></div></div><div class="checkout-total"><span>Total</span><strong>{{ course.price }} DT</strong></div><form method="post" action="{{ path('app_payment_status',{courseId:course.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('checkout') }}"><button class="button button-primary button-full button-lg" type="submit">Continue to payment →</button></form><p class="muted tiny">Demo checkout preview. Payment processing will be connected to the Checkout domain.</p></section><aside class="checkout-aside"><h3>What’s included</h3><p>✓ Full course access</p><p>✓ Lifetime access to recorded lessons</p><p>✓ Shared access for all children</p><p>✓ Individual progress tracking</p></aside></div></main>{% include 'components/_footer.html.twig' %}{% endblock %}

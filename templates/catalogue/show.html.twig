{% extends 'base.html.twig' %}
{% block title %}{{ course.title }} — MAAK{% endblock %}
{% block body %}{% include 'components/_navbar.html.twig' %}
<main>
    <section class="course-detail-hero"><div class="page-wrap detail-hero-grid"><div class="detail-copy"><div class="breadcrumbs"><a href="{{ path('app_home') }}">Home</a><span>/</span><a href="{{ path('app_courses') }}">Courses</a><span>/</span><span>{{ course.subject }}</span></div><span class="tag">{{ course.subject }} · {{ course.level }}</span><h1>{{ course.title }}</h1><p>{{ course.subtitle }}</p><div class="detail-rating"><strong>★ {{ course.rating }}</strong><span>{{ course.reviews }} reviews</span><span>·</span><span>{{ course.lessonCount }} lessons</span><span>·</span><span>{{ course.duration }}</span></div><p class="detail-teacher">Created by <a href="{{ path('app_teacher_public', {id: teacher.id}) }}">{{ teacher.name }}</a></p></div><div class="detail-purchase"><img src="{{ asset('images/maak/' ~ course.image) }}" alt="{{ course.subject }}"><div class="purchase-body"><div class="purchase-price"><strong>{{ course.price }} DT</strong>{% if course.oldPrice is defined %}<del>{{ course.oldPrice }} DT</del><span class="discount">Save {{ ((course.oldPrice-course.price)/course.oldPrice*100)|round }}%</span>{% endif %}</div><p>One purchase. Learning access for every child in your family.</p><a class="button button-primary button-full" href="{{ path('app_checkout', {courseId: course.id}) }}">Buy this course <span>→</span></a><small>Secure checkout · Lifetime access</small></div></div></div></section>
    <section class="page-wrap detail-content-grid"><div class="detail-main"><section class="detail-section"><h2>What you’ll learn</h2><div class="objectives-grid">{% for objective in course.objectives %}<p><span>✓</span>{{ objective }}</p>{% endfor %}</div></section>
        <section class="detail-section"><h2>Course curriculum</h2><p class="muted">{{ course.sections|length }} sections · {{ course.lessonCount }} lessons · {{ course.duration }} total length</p><div class="curriculum">{% for section in course.sections %}<details class="curriculum-section" {% if loop.first %}open{% endif %}><summary><strong>{{ section.title }}</strong><span>{{ section.lessons|length }} lessons⌄</span></summary><div class="lesson-list">{% for lesson in section.lessons %}<div class="lesson-row"><span class="lesson-type">{% if lesson.type == 'Video' %}▷{% elseif lesson.type == 'PDF' %}▤{% elseif lesson.type == 'Quiz' %}?{% else %}▧{% endif %}</span><span>{{ lesson.title }}</span><small>{{ lesson.duration }}</small></div>{% endfor %}</div></details>{% endfor %}</div></section>
        <section class="detail-section"><h2>Meet your teacher</h2><div class="teacher-profile-card"><div class="teacher-avatar">{{ teacher.initials }}</div><div><h3><a href="{{ path('app_teacher_public', {id: teacher.id}) }}">{{ teacher.name }}</a></h3><p>{{ teacher.level }} · {{ teacher.field }}</p><p>{{ teacher.university }}</p><p>{{ teacher.bio }}</p></div></div></section>
        <section class="detail-section"><h2>What learners say</h2><div class="review-card"><strong>★★★★★ &nbsp; Clear and easy to follow</strong><p>Really helpful explanations and practical examples. The lessons make difficult topics easier to understand.</p><small>Parent review · MAAK learner</small></div></section>
    </div><aside class="detail-sticky"><h3>Ready to get started?</h3><p>Learn whenever it works for your family.</p><a class="button button-primary button-full" href="{{ path('app_checkout', {courseId: course.id}) }}">Buy course · {{ course.price }} DT</a><ul><li>✓ Full course access</li><li>✓ Learn at your own pace</li><li>✓ Available to all children</li><li>✓ Progress tracking</li></ul></aside></section>
</main>{% include 'components/_footer.html.twig' %}{% endblock %}

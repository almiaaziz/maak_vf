{% extends 'base.html.twig' %}
{% set isParent = role == 'parent' %}
{% set isTeacher = role == 'teacher' %}
{% set roleName = isParent ? 'Parent' : (isTeacher ? 'Teacher' : 'Admin') %}
{% set sectionTitle = section|replace({'-':' '})|title %}
{% block title %}{{ sectionTitle }} — MAAK{% endblock %}
{% block body %}
<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <a href="{{ path('app_home') }}" class="brand sidebar-brand"><span class="brand-mark">▤</span>MAAK<span class="brand-dot">.</span></a>
        <div class="sidebar-caption">{{ roleName }} workspace</div>
        {% if isParent %}
            <nav class="sidebar-nav"><a class="{{ section == 'dashboard' ? 'active' }}" href="{{ path('app_parent_dashboard') }}">⌂ <span>Dashboard</span></a><a class="{{ section == 'children' or section == 'child' ? 'active' }}" href="{{ path('app_parent_section',{section:'children'}) }}">♧ <span>Children</span></a><a class="{{ section == 'courses' ? 'active' }}" href="{{ path('app_parent_section',{section:'courses'}) }}">▤ <span>My Courses</span></a><a href="{{ path('app_courses') }}">⌕ <span>Browse Courses</span></a><a class="{{ section == 'orders' ? 'active' }}" href="{{ path('app_parent_section',{section:'orders'}) }}">▣ <span>Orders & Payments</span></a><a class="{{ section == 'notifications' ? 'active' }}" href="{{ path('app_parent_section',{section:'notifications'}) }}">♢ <span>Notifications</span></a></nav>
            <div class="sidebar-caption sidebar-caption-bottom">Account</div><nav class="sidebar-nav"><a href="{{ path('app_parent_section',{section:'profile'}) }}">◎ <span>Profile</span></a><a href="{{ path('app_parent_section',{section:'settings'}) }}">⚙ <span>Settings</span></a></nav>
        {% elseif isTeacher %}
            <nav class="sidebar-nav"><a class="{{ section == 'dashboard' ? 'active' }}" href="{{ path('app_teacher_dashboard') }}">⌂ <span>Dashboard</span></a><a class="{{ section == 'courses' ? 'active' }}" href="{{ path('app_teacher_section',{section:'courses'}) }}">▤ <span>My Courses</span></a><a href="{{ path('app_teacher_course_new') }}">＋ <span>Create Course</span></a><a class="{{ section == 'students' ? 'active' }}" href="{{ path('app_teacher_section',{section:'students'}) }}">♧ <span>Students</span></a><a class="{{ section == 'sales' ? 'active' }}" href="{{ path('app_teacher_section',{section:'sales'}) }}">▣ <span>Sales</span></a><a class="{{ section == 'notifications' ? 'active' }}" href="{{ path('app_teacher_section',{section:'notifications'}) }}">♢ <span>Notifications</span></a></nav>
            <div class="sidebar-caption sidebar-caption-bottom">Account</div><nav class="sidebar-nav"><a href="{{ path('app_teacher_section',{section:'profile'}) }}">◎ <span>Profile</span></a><a href="{{ path('app_teacher_section',{section:'settings'}) }}">⚙ <span>Settings</span></a></nav>
        {% else %}
            <nav class="sidebar-nav"><a class="active" href="{{ path('app_admin_dashboard') }}">⌂ <span>Dashboard</span></a>{% for item in ['users','courses','categories','subjects','school-levels','orders','payments','reports','audit-logs','settings'] %}<a href="{{ path('app_admin_section',{section:item}) }}">▤ <span>{{ item|replace({'-':' '})|title }}</span></a>{% endfor %}</nav>
        {% endif %}
        <div class="sidebar-user"><div class="user-avatar">{{ app.user ? app.user.firstName|slice(0,1)|upper : 'M' }}</div><div><strong>{{ app.user ? app.user.fullName : 'MAAK user' }}</strong><small>{{ roleName }}</small></div><a href="{{ path('app_logout') }}" title="Log out">↗</a></div>
    </aside>
    <main class="dashboard-main">
        <header class="dashboard-topbar"><a href="{{ path('app_home') }}" class="mobile-brand brand"><span class="brand-mark">▤</span>MAAK<span class="brand-dot">.</span></a><div class="topbar-spacer"></div><a href="{{ path('app_courses') }}" class="topbar-browse">Explore courses ↗</a><span class="topbar-avatar">{{ app.user ? app.user.firstName|slice(0,1)|upper : 'M' }}</span></header>
        <div class="dashboard-content">
            {% if section == 'dashboard' %}
                <div class="dashboard-heading"><div><p class="eyebrow">{{ isParent ? 'Your family space' : (isTeacher ? 'Creator studio' : 'Platform overview') }}</p><h1>{{ isParent ? 'Good morning' : 'Welcome back' }}{% if app.user %}, {{ app.user.firstName }}{% endif %} 👋</h1><p>{{ isParent ? 'Here’s what is happening with your family’s learning.' : 'Here’s a snapshot of your MAAK activity.' }}</p></div>{% if isTeacher %}<a class="button button-primary" href="{{ path('app_teacher_course_new') }}">＋ Create course</a>{% endif %}</div>
                {% if isParent %}
                    <div class="dashboard-section-head"><div><h2>Your children</h2><p>Follow their individual learning journeys.</p></div><a href="{{ path('app_parent_section',{section:'children'}) }}" class="text-link">Manage children →</a></div>
                    <div class="child-cards"><article class="child-card"><div class="child-avatar">Y</div><div><h3>Youssef</h3><p>9th Grade · 2 courses</p></div><strong>72%<small>overall progress</small></strong><a href="{{ path('app_parent_child',{id:'youssef'}) }}">View progress →</a></article><article class="child-card"><div class="child-avatar child-teal">S</div><div><h3>Sara</h3><p>7th Grade · 1 course</p></div><strong>54%<small>overall progress</small></strong><a href="{{ path('app_parent_child',{id:'sara'}) }}">View progress →</a></article></div>
                    <div class="dashboard-section-head"><div><h2>Continue learning</h2><p>Pick up where your children left off.</p></div><a href="{{ path('app_parent_section',{section:'courses'}) }}" class="text-link">View all →</a></div>
                    <div class="mini-course-list">{% for course in courses %}<div class="mini-course"><img src="{{ asset('images/maak/' ~ course.image) }}"><div><strong>{{ course.title }}</strong><small>{{ course.subject }} · Youssef</small><div class="progress-track"><span style="width:{{ loop.index == 1 ? 72 : 48 }}%"></span></div></div><a href="{{ path('app_learn',{courseId:course.id}) }}">Continue →</a></div>{% endfor %}</div>
                    <div class="quick-actions"><a href="{{ path('app_courses') }}">⌕ <strong>Explore courses</strong><span>Find the next course</span></a><a href="{{ path('app_parent_section',{section:'children'}) }}">＋ <strong>Add a child</strong><span>Grow your family space</span></a><a href="{{ path('app_parent_section',{section:'orders'}) }}">▣ <strong>View orders</strong><span>See your purchases</span></a></div>
                {% elseif isTeacher %}
                    <div class="metric-grid"><div class="metric-card"><span>▤</span><small>Courses</small><strong>2</strong><em>Published courses</em></div><div class="metric-card"><span>♧</span><small>Students</small><strong>74</strong><em>Across your courses</em></div><div class="metric-card"><span>↗</span><small>Revenue</small><strong>1,250 DT</strong><em>Total sales</em></div><div class="metric-card"><span>◷</span><small>Pending courses</small><strong>1</strong><em>Under review</em></div></div>
                    <div class="dashboard-section-head"><div><h2>My courses</h2><p>Manage your published courses and drafts.</p></div><a href="{{ path('app_teacher_section',{section:'courses'}) }}" class="text-link">View all →</a></div><div class="mini-course-list">{% for course in courses|slice(0,3) %}<div class="mini-course"><img src="{{ asset('images/maak/' ~ course.image) }}"><div><strong>{{ course.title }}</strong><small>{{ course.subject }} · {{ course.lessonCount }} lessons</small></div><span class="status-pill">Published</span></div>{% endfor %}</div>
                {% else %}
                    <div class="metric-grid"><div class="metric-card"><span>▤</span><small>Courses</small><strong>24</strong><em>Across the platform</em></div><div class="metric-card"><span>♧</span><small>Users</small><strong>1,540</strong><em>Parents and teachers</em></div><div class="metric-card"><span>▣</span><small>Orders</small><strong>328</strong><em>All time</em></div><div class="metric-card"><span>◷</span><small>Pending review</small><strong>6</strong><em>Need attention</em></div></div>
                {% endif %}
            {% elseif section == 'children' %}
                <div class="dashboard-heading"><div><p class="eyebrow">Family management</p><h1>My Children</h1><p>Manage profiles and follow their progress.</p></div><button class="button button-primary" type="button" onclick="document.getElementById('add-child-form').hidden=false">＋ Add child</button></div>
                <div id="add-child-form" class="panel-card" hidden><h2>Add a child profile</h2><form class="auth-form inline-form"><label>Child name<input placeholder="Child's name"></label><label>Date of birth<input type="date"></label><label>School level<select><option>Primary</option><option>Middle school</option><option>High school</option></select></label><button class="button button-primary" type="button" onclick="this.closest('.panel-card').hidden=true">Save profile</button></form><p class="muted">Profile creation will be connected to the Family domain in the next backend phase.</p></div>
                <div class="child-cards"><article class="child-card"><div class="child-avatar">Y</div><div><h3>Youssef</h3><p>9th Grade · 2 courses</p></div><strong>72%<small>overall progress</small></strong><a href="{{ path('app_parent_child',{id:'youssef'}) }}">View profile →</a></article><article class="child-card"><div class="child-avatar child-teal">S</div><div><h3>Sara</h3><p>7th Grade · 1 course</p></div><strong>54%<small>overall progress</small></strong><a href="{{ path('app_parent_child',{id:'sara'}) }}">View profile →</a></article></div>
            {% elseif section == 'child' %}
                <div class="dashboard-heading"><div><p class="eyebrow">Learning profile</p><h1>{{ childId|default('Child')|title }}’s progress</h1><p>This profile is managed from your parent account.</p></div><a class="button button-outline" href="{{ path('app_parent_section',{section:'children'}) }}">← All children</a></div><div class="metric-grid"><div class="metric-card"><small>Overall progress</small><strong>72%</strong><em>Across active courses</em></div><div class="metric-card"><small>Courses</small><strong>2</strong><em>Available to learn</em></div><div class="metric-card"><small>Lessons completed</small><strong>18</strong><em>Keep it up!</em></div></div><div class="dashboard-section-head"><h2>Learning progress</h2></div>{% for course in courses|slice(0,3) %}<div class="progress-course"><div><strong>{{ course.title }}</strong><small>{{ course.subject }}</small></div><strong>{{ loop.index == 1 ? 85 : 60 }}%</strong><div class="progress-track"><span style="width:{{ loop.index == 1 ? 85 : 60 }}%"></span></div></div>{% endfor %}
            {% elseif section == 'courses' %}
                <div class="dashboard-heading"><div><p class="eyebrow">{{ roleName }} workspace</p><h1>{{ isParent ? 'My Courses' : 'My Courses' }}</h1><p>{{ isParent ? 'Courses purchased once and shared with your children.' : 'Your published and draft courses.' }}</p></div>{% if isTeacher %}<a class="button button-primary" href="{{ path('app_teacher_course_new') }}">＋ Create course</a>{% else %}<a class="button button-primary" href="{{ path('app_courses') }}">Explore courses →</a>{% endif %}</div>
                {% if isParent %}
                    {% for course in courses %}<article class="owned-course panel-card"><img src="{{ asset('images/maak/' ~ course.image) }}" alt=""><div><h2>{{ course.title }}</h2><p>{{ course.teacher }} · {{ course.subject }}</p><strong>Available for all your children</strong><div class="access-tags"><span>✓ Youssef · 60%</span><span>✓ Sara · 20%</span></div><a class="text-link" href="{{ path('app_learn',{courseId:course.id}) }}">Continue learning →</a></div></article>{% else %}<div class="empty-state"><h2>You haven’t purchased any courses yet</h2><p>Explore courses to start learning as a family.</p><a class="button button-primary" href="{{ path('app_courses') }}">Explore courses</a></div>{% endfor %}
                {% else %}
                    <div class="course-grid">{% for course in courses %}{% include 'components/_course_card.html.twig' with {course:course} %}{% endfor %}</div>
                {% endif %}
            {% elseif section == 'orders' %}
                <div class="dashboard-heading"><div><p class="eyebrow">Family purchases</p><h1>Orders & Payments</h1><p>Your course purchases and payment history.</p></div></div>
                <div class="panel-card table-wrap"><table class="data-table"><thead><tr><th>Order</th><th>Course</th><th>Amount</th><th>Status</th></tr></thead><tbody>{% for course in courses %}<tr><td>MAAK-1001</td><td>{{ course.title }}</td><td>{{ course.price }} DT</td><td><span class="status-pill">Successful</span></td></tr>{% else %}<tr><td colspan="4">No orders yet. <a class="text-link" href="{{ path('app_courses') }}">Explore courses →</a></td></tr>{% endfor %}</tbody></table></div>
            {% elseif section == 'students' or section == 'sales' or section == 'payments' %}
                <div class="dashboard-heading"><div><p class="eyebrow">{{ roleName }} workspace</p><h1>{{ sectionTitle }}</h1><p>Review your {{ section|replace({'-':' '}) }} activity and details.</p></div></div>
                {% if isTeacher and section == 'students' %}<div class="metric-grid"><div class="metric-card"><small>Active learners</small><strong>74</strong><em>Across your courses</em></div><div class="metric-card"><small>Courses</small><strong>{{ courses|length }}</strong><em>Published</em></div></div><div class="panel-card table-wrap"><table class="data-table"><thead><tr><th>Learner</th><th>Course</th><th>Progress</th><th>Last activity</th></tr></thead><tbody><tr><td>Youssef A.</td><td>Algebra Essentials</td><td>82%</td><td>Today</td></tr><tr><td>Sara M.</td><td>Geometry Workshop</td><td>64%</td><td>Yesterday</td></tr><tr><td>Ahmed B.</td><td>Algebra Essentials</td><td>45%</td><td>2 days ago</td></tr></tbody></table></div>
                {% elseif isTeacher and section == 'sales' %}<div class="metric-grid"><div class="metric-card"><small>Total revenue</small><strong>1,250 DT</strong><em>All time</em></div><div class="metric-card"><small>Course sales</small><strong>58</strong><em>Successful purchases</em></div><div class="metric-card"><small>Pending payout</small><strong>180 DT</strong><em>Simulated balance</em></div></div><div class="panel-card"><h2>Recent sales</h2><p class="muted">Your course sales and payouts will be listed here.</p></div>
                {% else %}<div class="panel-card"><div class="empty-state compact"><span>▤</span><h2>Your {{ section|replace({'-':' '}) }} will appear here</h2><p>This interface is ready for the corresponding Symfony domain and database integration.</p></div></div>{% endif %}
            {% else %}
                <div class="dashboard-heading"><div><p class="eyebrow">{{ roleName }} workspace</p><h1>{{ sectionTitle }}</h1><p>Manage your MAAK {{ section|replace({'-':' '}) }}.</p></div></div><div class="panel-card"><div class="empty-state compact"><span>✧</span><h2>{{ sectionTitle }} workspace</h2><p>The page structure is migrated. The data actions will be connected as the corresponding backend module is implemented.</p></div></div>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}

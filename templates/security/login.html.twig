{% extends 'base.html.twig' %}
{% block title %}Log in — MAAK{% endblock %}
{% block body %}<div class="auth-shell"><a href="{{ path('app_home') }}" class="brand auth-brand"><span class="brand-mark">▤</span>MAAK<span class="brand-dot">.</span></a><div class="auth-card"><a class="back-link" href="{{ path('app_home') }}">← Back to home</a><p class="eyebrow">Welcome back</p><h1>Log in to MAAK</h1><p class="auth-intro">Continue your family’s learning journey.</p>
    {% for message in app.flashes('success') %}<div class="alert-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="alert-error">{{ message }}</div>{% endfor %}
    {% if error %}<div class="alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
    <form method="post" action="{{ path('app_login') }}" class="auth-form"><label>Email address<input type="email" name="email" value="{{ last_username }}" placeholder="you@example.com" required autocomplete="email"></label><label>Password <a href="{{ path('app_forgot_password') }}">Forgot password?</a><input type="password" name="password" placeholder="Enter your password" required autocomplete="current-password"></label><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="button button-primary button-full button-lg" type="submit">Log in <span>→</span></button></form>
    <div class="auth-divider"><span>OR</span></div><button type="button" class="button button-outline button-full" onclick="document.getElementById('google-note').hidden=false">Continue with Google</button><p id="google-note" class="auth-switch" hidden>Google sign-in will be available when authentication is connected.</p><p class="auth-switch">Don’t have an account? <a href="{{ path('app_register') }}">Create one</a></p></div><p class="auth-legal">Secure access to your MAAK learning space.</p></div>{% endblock %}

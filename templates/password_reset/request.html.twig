{% extends 'base.html.twig' %}
{% block title %}Reset password — MAAK{% endblock %}
{% block body %}<div class="auth-shell"><a href="{{ path('app_home') }}" class="brand auth-brand"><span class="brand-mark">▤</span>MAAK<span class="brand-dot">.</span></a><div class="auth-card"><a class="back-link" href="{{ path('app_login') }}">← Back to login</a><p class="eyebrow">Account recovery</p><h1>Reset your password</h1><p class="auth-intro">Enter your email address and we’ll send you a link to reset your password.</p>{% for message in app.flashes('success') %}<div class="alert-success">{{ message }}</div>{% endfor %}<form method="post" class="auth-form"><label>Email address<input type="email" name="email" placeholder="you@example.com" required autocomplete="email"></label><input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}"><button class="button button-primary button-full button-lg" type="submit">Send reset link →</button></form></div></div>{% endblock %}

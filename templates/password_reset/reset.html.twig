{% extends 'base.html.twig' %}
{% block title %}Choose a new password — MAAK{% endblock %}
{% block body %}<div class="auth-shell"><a href="{{ path('app_home') }}" class="brand auth-brand"><span class="brand-mark">▤</span>MAAK<span class="brand-dot">.</span></a><div class="auth-card"><p class="eyebrow">Account recovery</p><h1>Choose a new password</h1><form method="post" class="auth-form"><label>New password<input type="password" name="password" minlength="8" required></label><label>Confirm new password<input type="password" name="confirm_password" minlength="8" required></label><input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}"><button class="button button-primary button-full button-lg">Update password →</button></form></div></div>{% endblock %}

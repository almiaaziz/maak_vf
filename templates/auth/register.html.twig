{% extends 'base.html.twig' %}
{% block title %}Create an account — MAAK{% endblock %}
{% block body %}<div class="auth-shell"><a href="{{ path('app_home') }}" class="brand auth-brand"><span class="brand-mark">▤</span>MAAK<span class="brand-dot">.</span></a><div class="auth-card"><a class="back-link" href="{{ path('app_home') }}">← Back to home</a><p class="eyebrow">Join the learning community</p><h1>Create your MAAK account</h1><p class="auth-intro">Choose how you want to use MAAK. You can always explore courses before signing in.</p><a class="role-choice" href="{{ path('app_register_parent') }}"><span class="role-icon">♧</span><span><strong>I’m a parent</strong><small>Find courses for your children</small></span><b>→</b></a><a class="role-choice" href="{{ path('app_register_teacher') }}"><span class="role-icon role-teal">✎</span><span><strong>I’m a university student</strong><small>Create courses as a teacher</small></span><b>→</b></a><p class="auth-switch">Already have an account? <a href="{{ path('app_login') }}">Log in</a></p></div><p class="auth-legal">By continuing, you agree to MAAK’s terms and privacy policy.</p></div>{% endblock %}
